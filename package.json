{
  "name": "sciencecenter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An interactive 3D science center with Buddy, a talking robot guide",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"npm:dev:server\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "hono": "4.13.13",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
