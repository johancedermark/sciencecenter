# OpenAI API key for talking to Buddy by voice (OpenAI Realtime API). Server-side only: the browser
# only ever gets a 10-minute ephemeral client secret. Without it, Buddy uses browser speech and
# offline replies to typed messages.
OPENAI_API_KEY=
# Optional overrides
REALTIME_MODEL=gpt-realtime-2.1-mini
# alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar (marin/cedar recommended)
REALTIME_VOICE=marin
PORT=8790
# Set to 1 when running behind a reverse proxy so rate limiting uses X-Forwarded-For.
# TRUST_PROXY=1
